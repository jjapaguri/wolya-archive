{
  "permissions": {
    "deny": [
      "Read(./.next/**)",
      "Read(./.git/**)",
      "Read(./package-lock.json)",
      "Read(./.env*)",
      "Read(./**/*.pem)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "git pull --ff-only --autostash"
          }
        ]
      }
    ]
  }
}
